# JARVIS Configuration Template
# Copy this file to .env and insert your real credentials.

# Primary Web Search (Free Tier: https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# Backup Web Search (Optional: https://brave.com/search/api/)
BRAVE_API_KEY=

# Google Cloud OAuth Desktop Client Credentials (Shared for Calendar & Gmail)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Tailscale Device Gateway Auth Token (Mandatory token for remote mesh auth)
TAILSCALE_AUTH_KEY=
GATEWAY_AUTH_TOKEN=

# WhatsApp Business API Key (Optional official API only)
WHATSAPP_BUSINESS_API_KEY=

# Home Assistant Long-Lived Access Token (Optional: http://homeassistant.local:8123)
HOME_ASSISTANT_TOKEN=
